# App
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=MoveUp

# Auth
JWT_SECRET=change-me-in-production-min-32-chars-long
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=2592000

# Database (MongoDB via Mongoose — local mongod for dev, Atlas URI in prod)
MONGODB_URI="mongodb://localhost:27017/moveup"

# Seed admin
SEED_ADMIN_EMAIL=admin@moveup.tn
SEED_ADMIN_PASSWORD="Admin#2026!"

# Web3 / on-chain employment contracts (MetaMask) — Polygon Amoy testnet
# Deploy first: cd blockchain && npm run deploy:amoy (prints these values).
NEXT_PUBLIC_CHAIN_ID=80002
NEXT_PUBLIC_CHAIN_NAME="Polygon Amoy"
NEXT_PUBLIC_RPC_URL=https://rpc-amoy.polygon.technology
NEXT_PUBLIC_CONTRACT_ADDRESS=
NEXT_PUBLIC_BLOCK_EXPLORER_URL=https://amoy.polygonscan.com

# System wallet that sends (and pays for) the on-chain contract transactions.
# It is NOT an app user: HR and employees only sign EIP-712 intents, which are
# free. Fund this wallet with testnet POL; keep it out of git.
# Make this wallet the registry owner so the app can auto-authorise every
# auto-generated HR wallet (setHrAdmin). If the owner is another account,
# grant HR wallets manually with the blockchain grant script.
CONTRACT_ADMIN_PRIVATE_KEY=

# Custodial wallet encryption key (AES-256-GCM). Every HR/employee account gets
# an app-managed wallet whose private key is encrypted with this secret. Generate
# one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep it stable and out of git: losing it makes stored wallet keys unrecoverable.
WALLET_ENCRYPTION_KEY=

# Local Hardhat (optional):
# NEXT_PUBLIC_CHAIN_ID=31337
# NEXT_PUBLIC_CHAIN_NAME="Hardhat Local"
# NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8545
# NEXT_PUBLIC_CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3

# Voice check-in (Kaggle notebook exposed via ngrok).
# Public ngrok URL printed by the notebook's last cell, e.g.
# https://paloma-cranelike-kathrin.ngrok-free.dev
VOICE_API_BASE_URL=
# NEXT_PUBLIC_BLOCK_EXPLORER_URL=
