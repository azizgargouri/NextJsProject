# App
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=MoveUp

# Auth
JWT_SECRET=change-me-in-production-min-32-chars-long
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=2592000

# Database (MongoDB via Mongoose — local mongod for dev, Atlas URI in prod)
MONGODB_URI="mongodb://localhost:27017/moveup"
MONGODB_DB_NAME=moveup

# Set to false only to serve production over plain http (npm run offline does this).
# COOKIE_SECURE=false

# Set to off to make offer estimates ignore the learned duration model and use the basic rules.
# PROFIT_MODEL=off

# Mover workspace
OFFER_TTL_MINUTES=120
UPLOAD_DIR=.uploads

# Seed admin
SEED_ADMIN_EMAIL=admin@moveup.tn
SEED_ADMIN_PASSWORD="Admin#2026!"
