# App
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=MoveUp

# Auth
JWT_SECRET=change-me-in-production-min-32-chars-long
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=2592000

# Database (MongoDB via Mongoose — local mongod for dev, Atlas URI in prod)
MONGODB_URI="mongodb://localhost:27017/moveup"
MONGODB_DB_NAME=moveup

# Mover workspace
OFFER_TTL_MINUTES=120
UPLOAD_DIR=.uploads

# Seed admin
SEED_ADMIN_EMAIL=admin@moveup.tn
SEED_ADMIN_PASSWORD="Admin#2026!"

# AI — Vercel AI SDK (course ch.6). Server-side only: never prefix with NEXT_PUBLIC_.
# Put real keys in .env.local (git-ignored). Without a key every AI feature falls back to rules.
AI_PROVIDER=openai            # openai | google
AI_MODEL=                     # optional, defaults: gpt-4o-mini / gemini-2.5-flash
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
AI_RATE_LIMIT_PER_HOUR=30

# HR contract registry (optional; contracts stay usable off-chain when unset)
CHAIN_RPC_URL=
CHAIN_REGISTRY_ADDRESS=
CHAIN_OPERATOR_PRIVATE_KEY=
WALLET_ENCRYPTION_KEY=
