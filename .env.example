# App
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=MoveUp

# Auth
JWT_SECRET=change-me-in-production-min-32-chars-long
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=2592000

# Database (MongoDB via Mongoose — local mongod for dev, Atlas URI in prod)
MONGODB_URI="mongodb://localhost:27017/moveup"
MONGODB_DB_NAME=moveup

# Set to false only to serve production over plain http (npm run offline does this).
# COOKIE_SECURE=false

# Set to off to make offer estimates ignore the learned duration model and use the basic rules.
# PROFIT_MODEL=off

# Mover workspace
OFFER_TTL_MINUTES=120
UPLOAD_DIR=.uploads
# Where mover photos/documents go: disk (default locally), s3, or mongo.
# On Vercel it is automatic: the S3 bucket when S3_* is set, otherwise MongoDB.
# MOVER_STORAGE=disk

# Seed admin
SEED_ADMIN_EMAIL=admin@moveup.tn
SEED_ADMIN_PASSWORD="Admin#2026!"

# AI — Vercel AI SDK (course ch.6). Server-side only: never prefix with NEXT_PUBLIC_.
# Put real keys in .env.local (git-ignored). Without a key every AI feature falls back to rules.
AI_PROVIDER=openai            # openai | google | groq (claims, reviews, assistant)
AI_MODEL=                     # optional, defaults: gpt-4o-mini / gemini-2.5-flash / openai/gpt-oss-120b
AI_VISION_MODEL=              # optional, claim photo scanner; Groq default qwen/qwen3.8-27b
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
AI_RATE_LIMIT_PER_HOUR=30

# HR contract registry (optional; contracts stay usable off-chain when unset)
NEXT_PUBLIC_CHAIN_ID=
NEXT_PUBLIC_RPC_URL=
NEXT_PUBLIC_CONTRACT_ADDRESS=
CONTRACT_ADMIN_PRIVATE_KEY=
WALLET_ENCRYPTION_KEY=

# Object storage (avatars, admin storage, mover files on Vercel).
# Local: RustFS via `docker compose up -d` (values below).
# Production (Cloudflare R2): S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com,
# S3_REGION=auto, S3_BUCKET=moveup, keys from an R2 API token (Object Read & Write).
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=moveupadmin
S3_SECRET_KEY="moveupsecret"
S3_BUCKET=moveup

# Local AI (Ollama: `ollama serve`, then `ollama pull qwen2.5-coder:7b qwen2.5vl:7b`)
# OLLAMA_MODEL is shared: the landing inventory assistant (text requests) and the
# smart room layout planner both use it. Photos go to OLLAMA_VISION_MODEL.
OLLAMA_URL=http://localhost:11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_VISION_MODEL=qwen2.5vl:7b
# Smart room layout falls back to Groq when Ollama is missing or slow
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Seeder playground (/admin/playground, `yarn db:playground`): always on in development.
# Production refuses to write fake data unless this is true (e.g. a demo deployment).
PLAYGROUND_ENABLED=false
